{
  "entities": {
    "systemUsers": {
      "title": "SystemUser",
      "description": "Usuários e clientes lojistas cadastrados para acessar o sistema",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "ID do usuário no Firebase Auth ou identificador único" },
        "nome": { "type": "string", "description": "Nome do operador ou lojista" },
        "nomeLoja": { "type": "string", "description": "Nome da loja ou marca" },
        "email": { "type": "string", "description": "E-mail de acesso" },
        "whatsapp": { "type": "string", "description": "WhatsApp de contato do lojista" },
        "role": { "type": "string", "enum": ["admin", "lojista", "vendedora"], "description": "Perfil de acesso" },
        "status": { "type": "string", "enum": ["ativo", "suspenso", "pendente"], "description": "Status da conta no sistema" },
        "createdAt": { "type": "string", "description": "Data de criação ISO" },
        "criadoPor": { "type": "string", "description": "E-mail do administrador que cadastrou" }
      },
      "required": ["email", "nome", "role", "status"]
    },
    "admins": {
      "title": "Admin",
      "description": "Documentos de administradores mestres do sistema",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/systemUsers/{userId}": {
      "schema": "systemUsers",
      "description": "Coleção de clientes e lojistas que utilizam o sistema"
    },
    "/admins/{adminId}": {
      "schema": "admins",
      "description": "Administradores autorizados a gerenciar clientes e acessos"
    }
  }
}
